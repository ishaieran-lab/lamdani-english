rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Fields a user must never be able to set on themselves. Access and money
    // are decided by the admin or by a Cloud Function, never by the browser.
    function protectedFields() {
      return [
        'premium', 'premiumSince', 'premiumExpiry', 'premiumUntil',
        'premiumPlan', 'payments', 'amountPaid', 'renewalReminderSent',
        '_deleted', '_deletedAt',
        'cardcomToken', 'last4', 'cancelAtPeriodEnd', 'chargeFailedAt',
        'note', 'price'
      ];
    }

    function touchesProtected() {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(protectedFields());
    }

    match /users/{userId} {
      // Admin: full access
      allow read, write: if request.auth != null
                         && request.auth.token.email == 'ishaieran@gmail.com';

      // Users read their own document
      allow read: if request.auth != null && request.auth.uid == userId;

      // Users create their own document, but cannot grant themselves anything
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny(protectedFields());

      // Users update their own kids and progress only — the protected fields
      // stay exactly as they were
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !touchesProtected();
    }

    // Premium requests: a user may file one for themselves and read it back,
    // but only the admin may approve, change or delete it.
    match /premiumRequests/{reqId} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == 'ishaieran@gmail.com';

      allow read: if request.auth != null && resource.data.uid == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
    }
  }
}
